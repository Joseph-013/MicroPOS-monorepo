{
  "name": "micropos",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @micropos/web dev",
    "dev:desktop": "pnpm --filter @micropos/core --filter @micropos/theme build && pnpm --filter @micropos/desktop dev",
    "dev": "pnpm dev:desktop",
    "db:migrate": "pnpm --filter @micropos/desktop db:migrate",
    "db:seed": "pnpm --filter @micropos/desktop db:seed",
    "db:generate": "pnpm --filter @micropos/desktop db:generate"
  }
}
