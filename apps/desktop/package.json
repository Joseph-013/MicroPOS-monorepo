{
  "name": "@micropos/desktop",
  "version": "2.18.1",
  "productName": "MicroPOS",
  "desktopName": "micropos.desktop",
  "scripts": {
    "ng": "ng",
    "build:renderer": "ng build",
    "build:electron": "node -e \"require('node:fs').rmSync('dist/electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json && pnpm build:preload",
    "build": "pnpm build:renderer && pnpm build:electron",
    "start": "pnpm build && electron-forge start",
    "start:renderer": "ng serve",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "dev": "node scripts/dev.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --root electron",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.js",
    "db:migrate": "pnpm build:electron && node dist/electron/db/migrate-cli.js",
    "db:seed": "pnpm build:electron && node dist/electron/db/migrate-cli.js --seed"
  },
  "private": true,
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@micropos/core": "workspace:*",
    "@micropos/theme": "workspace:*",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.9.0",
    "@spartan-ng/cli": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "jsqr": "^1.4.0",
    "luxon": "^3.7.2",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "MicroPOS point-of-sale desktop app",
  "main": "dist/electron/main.js",
  "author": "MicroPOS",
  "license": "UNLICENSED",
  "dependencies": {
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "qrcode-generator": "^2.0.4",
    "usb": "^3.3.0",
    "ws": "^8.23.0"
  }
}
