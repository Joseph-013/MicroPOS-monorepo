erDiagram
    employees ||--o{ login_sessions : "signs in"
    employees ||--o{ orders : "rings up"
    employees |o--o{ audit_log : "performs"
    settings }o..o{ products : "checkout.draft lines (JSON, no FK)"
    products ||--o{ product_categories : "in"
    products ||--o{ product_batches : "delivered as"
    product_batches ||--o{ stock_movements : "ledger"
    products ||--o{ stock_movements : "moves"
    order_lines |o--o{ stock_movements : "draws from"
    employees |o--o{ stock_movements : "records"
    categories ||--o{ product_categories : "groups"
    orders ||--|{ order_lines : "has"
    products |o--o{ order_lines : "sold as"
    orders ||--o{ payments : "paid_by"
    customers |o--o{ orders : "buys on credit"
    customers ||--o{ customer_ledger : "account"
    orders |o--o{ customer_ledger : "charged by"
    employees |o--o{ customer_ledger : "records"
    orders |o--o{ orders : "refunds"
    suppliers ||--o{ purchase_orders : "supplies"
    purchase_orders ||--|{ purchase_order_lines : "has"
    products ||--o{ purchase_order_lines : "bought as"
    purchase_orders ||--o{ purchase_payments : "paid by"
    suppliers ||--o{ supplier_returns : "refunds"
    purchase_orders |o--o{ supplier_returns : "credited by"
    product_batches ||--o{ supplier_returns : "sent back from"
    stock_movements ||--o| supplier_returns : "took out"
    employees |o--o{ purchase_orders : "places"
    purchase_order_lines |o--o{ stock_movements : "delivered as"
    employees |o--o{ purchase_payments : "records"

    employees {
        text id PK
        text name
        text employee_number UK
        text pin_hash
        text role
        text permissions "JSON list; null = the role's preset"
        int pin_change_required
        int active
        int failed_attempts
        int locked_until
        int created_at
        int updated_at
        int deleted_at
    }
    login_sessions {
        text id PK
        text employee_id FK
        int logged_in_at
        int logged_out_at
    }
    audit_log {
        text id PK
        text employee_id FK
        text action
        text entity
        text entity_id
        text detail
        int at
    }
    categories {
        text id PK
        text name UK
        int sort_order
        int created_at
        int updated_at
        int deleted_at
    }
    product_categories {
        text product_id PK
        text category_id PK
    }
    products {
        text id PK
        text name
        text sku UK
        text barcode UK "barcode or PLU"
        int price
        int cost
        text unit
        text tracking "none, quantity, batch, expiry"
        int shelf_life_days
        int critical_level_milli "low-stock level, null = none"
        int active
        int created_at
        int updated_at
        int deleted_at
    }
    product_batches {
        text id PK
        text product_id FK
        text batch_number UK "null for the unnamed batch"
        int received_at
        int expires_at
        int unit_cost
        int created_at
        int updated_at
    }
    stock_movements {
        text id PK
        text product_id FK
        text batch_id FK
        text type "receive, sale, refund, void, adjust, waste, expired, repack_out, repack_in, supplier_return"
        int quantity_milli "signed"
        text order_line_id FK
        text purchase_order_line_id FK "receipts against a purchase order"
        text employee_id FK
        int at
        text repackage_id "groups the movements of one repackage"
        text note
    }
    orders {
        text id PK
        text order_number UK
        text employee_id FK
        text customer_id FK
        text refund_of_order_id FK
        text status
        int subtotal
        int discount_total "line discounts + order discount"
        text discount_reason "why, if explained"
        text note "remark on the sale"
        int total
        int completed_at
        int created_at
        int updated_at
    }
    customers {
        text id PK
        text name
        text phone
        text note
        int credit_limit "null = no limit"
        text interest_mode "null = none; order or total"
        int interest_rate_bp "monthly, 300 = 3%"
        int interest_started_at "interest counts from here"
        int created_at
        int updated_at
        int deleted_at
    }
    customer_ledger {
        text id PK
        text customer_id FK
        text type "charge, payment, refund, void, adjustment, interest"
        int amount "signed cents; positive = customer owes"
        text order_id FK
        text method "payments only"
        text reference
        text note
        text employee_id FK
        int at
    }
    order_lines {
        text id PK
        text order_id FK
        text product_id FK
        text name
        int unit_price
        int unit_cost
        int quantity_milli
        int line_total "before the line discount"
        int discount "cents off this line"
    }
    payments {
        text id PK
        text order_id FK
        text method
        int amount
        int tendered
        int change
        text reference
        int created_at
    }
    settings {
        text key PK "store.name, receipt.footer, checkout.draft, product.draft.*"
        text value "JSON"
        int updated_at
    }
    suppliers {
        text id PK
        text name
        text phone
        text note
        int created_at
        int updated_at
        int deleted_at
    }
    purchase_orders {
        text id PK
        text po_number UK
        text supplier_id FK
        text status "ordered, received, cancelled"
        int ordered_at
        int expected_at
        int due_at
        int received_at
        text reference "supplier invoice no."
        text note
        int total "cents"
        text employee_id FK
        int created_at
        int updated_at
    }
    purchase_order_lines {
        text id PK
        text purchase_order_id FK
        text product_id FK
        int quantity_milli
        int unit_cost
    }
    supplier_returns {
        text id PK
        text supplier_id FK
        text purchase_order_id FK "the order the batch came on, if any"
        text product_id FK
        text batch_id FK
        text stock_movement_id FK
        int quantity_milli
        int refund_amount "cents"
        int credited_amount "the part that reduced what is owed"
        text note
        text employee_id FK
        int at
    }
    purchase_payments {
        text id PK
        text purchase_order_id FK
        int amount "cents, positive; append-only"
        text method
        text reference
        text note
        text employee_id FK
        int at
    }
